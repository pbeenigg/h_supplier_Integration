# 环境配置模板
# 复制此文件为 .env.development 或 .env.production 并填入对应值

# 环境类型 (development | production)
NODE_ENV=development

# 应用端口
PORT=9091

# API 基础 URL
# 开发环境: http://localhost:9090
# 生产环境: http://47.76.191.223:9090
NEXT_PUBLIC_API_BASE_URL=http://localhost:9090

# Next.js 应用环境标识
NEXT_PUBLIC_APP_ENV=development